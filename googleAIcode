#From the main Gemini toolbox (google.genai), I want to take out the compartment labeled types and make it easily available for me to use.
#Define 'short_config' to say only 200 tokens. If you have defined 'short_config' previously. If not then define first.
#While question asks for 1000 words, token limit wont allow it"
from google.genai import types
short_config = types.GenerateContentConfig(max_output_tokens=200)
response = client.models.generate_content(
    model='gemini-2.0-flash',
    config=short_config,
    contents='Write a 1000 word essay on the importance of olives in modern society.')

print(response.text)

#Define 'high_temp_config' to set high temperature. Could set multiple levels
#The 'for _ in range(5):' sets the questions to loop 5 times. High temp allows different answers. Low temp gets the same response
#if response.text: print(response.text, '-' * 25) says that after each response add 25 dashes"
high_temp_config = types.GenerateContentConfig(temperature=2.0)
for _ in range(5):
  response = client.models.generate_content(
      model='gemini-2.0-flash',
      config=high_temp_config,
      contents='Pick a random colour... (respond in a single word)')
if response.text:
    print(response.text, '-' * 25)

#Define 'low_temp_config' to set high temperature. Could set multiple levels
